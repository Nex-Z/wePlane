[Unit]
Description=wePlane Lightweight Server Control Center
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=weplane
Group=weplane
ExecStart=/usr/local/bin/weplane serve --addr 0.0.0.0:8080 --data-dir /var/lib/weplane
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/weplane

[Install]
WantedBy=multi-user.target
